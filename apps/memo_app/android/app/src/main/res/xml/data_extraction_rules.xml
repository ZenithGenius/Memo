<?xml version="1.0" encoding="utf-8"?>
<!-- Sauvegarde dans le cloud et transfert vers un nouveau téléphone, Android 12
     et après : mêmes règles que backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
