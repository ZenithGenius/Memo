# Copier vers .env (ignoré par Git) et renseigner. Ne jamais commiter de valeur réelle.
# SUPABASE_URL, SUPABASE_ANON_KEY et SUPABASE_SERVICE_ROLE_KEY sont injectés par la plateforme.

# Identifiant de la clé de signature (claim `kid`, permet la rotation)
LICENSE_KEY_ID=k1

# Clé privée Ed25519 au format PKCS8 en base64 (voir backend/README.md pour la générer)
LICENSE_PRIVATE_KEY_PKCS8=

# Optionnel : politique de durée (ADR-008), par défaut 7 et 45
# LICENSE_SHORT_TOKEN_DAYS=7
# LICENSE_MAX_TOKEN_DAYS=45
