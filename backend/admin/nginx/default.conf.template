# Rendu au démarrage par l'image nginx (envsubst) : seules les variables
# d'environnement définies, ici ${SUPABASE_URL}, sont remplacées.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;

    # Défense en profondeur contre l'injection (XSS) : aucun script tiers ni en
    # ligne, appels réseau limités à Supabase. style-src-attr couvre les
    # attributs style (inoffensifs, ne peuvent pas exécuter de script).
    add_header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; style-src-attr 'unsafe-inline'; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' ${SUPABASE_URL}; base-uri 'none'; form-action 'self'; frame-ancestors 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;

    location / {
        try_files $uri $uri/ =404;
    }

    # Généré au démarrage depuis l'environnement : jamais mis en cache.
    location = /config.js {
        expires -1;
    }

    # Rien d'autre que les fichiers du panneau n'est servi.
    location ~ /\. {
        deny all;
    }
}
