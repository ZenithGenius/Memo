# Copier vers .env (ignoré par Git) et renseigner, puis : docker compose up --build
# Local (`supabase start --workdir backend ...`) : utiliser host.docker.internal, pas 127.0.0.1,
# le conteneur ne voit pas l'hôte sous ce nom.
SUPABASE_URL=http://host.docker.internal:54321
SUPABASE_ANON_KEY=<clé anon affichée par `supabase status`>
