# Terminal de l'administrateur du serveur Memo (copié par provision.sh).
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""  # Starship dessine l'invite
plugins=(
    git
    docker
    zsh-autosuggestions
    zsh-syntax-highlighting
)
source "$ZSH/oh-my-zsh.sh"

# Bannière à l'ouverture du terminal, comme sur le poste de l'administrateur.
if [[ -t 1 ]]; then
  ~/.local/bin/genius-banner
  command -v fastfetch >/dev/null && fastfetch
  [[ -f /var/run/reboot-required ]] && print -P '%F{#b05f6d}  Redémarrage requis (mises à jour du noyau ou de bibliothèques).%f\n'
fi

HISTSIZE=50000
SAVEHIST=50000
setopt HIST_IGNORE_SPACE HIST_IGNORE_ALL_DUPS SHARE_HISTORY

# Invite Starship sur deux lignes ; la ligne du haut est imprimée comme une sortie,
# un redimensionnement ne redessine donc que « └─❯ » (voir ~/.config/starship.toml).
if command -v starship >/dev/null; then
  eval "$(starship init zsh)"
  autoload -Uz add-zsh-hook
  _memo_top() { print -r -- "$(STARSHIP_SHELL= starship prompt --profile top --terminal-width="$COLUMNS" --status="${STARSHIP_CMD_STATUS:-0}" --cmd-duration="${STARSHIP_DURATION:-}" --jobs="${STARSHIP_JOBS_COUNT:-0}")"; }
  _memo_precmd_top() { (( ${+_memo_seen} )) && print; _memo_seen=1; _memo_top; }
  add-zsh-hook precmd _memo_precmd_top
  _memo_cls() { print -n '\e[H\e[2J'; _memo_top; zle .reset-prompt; }
  zle -N clear-screen _memo_cls
fi

# eza : listes colorées
if command -v eza >/dev/null; then
  export EZA_COLORS="di=1;38;2;108;170;255:ex=1;38;2;111;227;232:ln=38;2;176;124;255:or=38;2;176;95;109:fi=38;2;201;212;222:ur=38;2;111;227;232:uw=38;2;176;124;255:ux=38;2;108;170;255:ue=38;2;108;170;255:gr=38;2;111;179;184:gw=38;2;139;127;179:gx=38;2;108;143;179:tr=38;2;111;179;184:tw=38;2;139;127;179:tx=38;2;108;143;179:sn=38;2;111;227;232:sb=38;2;77;93;109:uu=38;2;176;124;255:gu=38;2;140;140;255:da=38;2;77;93;109:ga=38;2;111;227;232:gm=38;2;108;170;255:gd=38;2;176;95;109:gv=38;2;176;124;255:gt=38;2;140;140;255:hd=4;38;2;143;166;189:*.zip=38;2;176;124;255:*.tar=38;2;176;124;255:*.gz=38;2;176;124;255:*.xz=38;2;176;124;255:*.7z=38;2;176;124;255:*.deb=38;2;176;124;255:*.md=38;2;198;246;255:*.pdf=38;2;140;140;255"
  alias ls='eza --group-directories-first'
  alias ll='eza -l --git --group-directories-first --time-style=relative --header'
  alias la='eza -la --git --group-directories-first --time-style=relative --header'
  alias lt='eza --tree --level=2 --group-directories-first'
fi

# fzf : Ctrl+R historique, Ctrl+T fichiers, Alt+C dossiers
if command -v fzf >/dev/null; then
  export FZF_DEFAULT_OPTS="--height=45% --layout=reverse --border=rounded --info=inline \
--color=bg+:#1c2731,bg:-1,spinner:#6fe3e8,hl:#b07cff,fg:#c9d4de,header:#6caaff,info:#4d5d6d \
--color=pointer:#6fe3e8,marker:#b07cff,fg+:#e6edf3,prompt:#6fe3e8,hl+:#b07cff,border:#3a4652"
  source <(fzf --zsh)
fi

# bat (batcat sous Ubuntu) : cat avec coloration
if command -v batcat >/dev/null; then
  alias bat='batcat'
  alias cat='batcat --paging=never'
fi

# zoxide : « z prod » saute vers un dossier fréquent
command -v zoxide >/dev/null && eval "$(zoxide init zsh)"

# Raccourcis d'exploitation
alias dps='docker ps --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}"'
alias dlogs='docker logs -f --tail 100'
alias decisions='sudo cscli decisions list'
alias alerts='sudo cscli alerts list'
