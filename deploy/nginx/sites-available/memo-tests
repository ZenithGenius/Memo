# tests.__DOMAIN__ : HTTP redirigé vers HTTPS, puis Kiwi TCMS (gestion des tests) sur 127.0.0.1:8443.
server {
    listen 80;
    listen [::]:80;
    server_name tests.__DOMAIN__;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name tests.__DOMAIN__;
    include snippets/memo-tls.conf;

    # Captures d'écran jointes aux résultats.
    client_max_body_size 12m;

    location / {
        # Kiwi ne sert qu'en HTTPS, avec un certificat auto-signé, sur la boucle locale.
        proxy_pass https://127.0.0.1:8443;
        proxy_ssl_verify off;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s;
    }
}
